{
  "name": "game-music",
  "version": "0.1.0",
  "description": "Generative ambient music for games: a deterministic composer and a Web Audio renderer, steered by moods, axes and plain-word prompts.",
  "license": "MIT",
  "author": "Max Williams",
  "type": "module",
  "sideEffects": false,
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./composer": {
      "types": "./dist-lib/composer.d.ts",
      "import": "./dist-lib/composer.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build:lib && vite build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "docs:table": "UPDATE_README=1 vitest run test/readme.test.ts",
    "preview": "vite preview",
    "prepare": "npm run build:lib"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
